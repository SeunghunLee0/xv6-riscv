#include "kernel/types.h"
#include "kernel/stat.h"
#include "user/user.h"
#include "kernel/param.h"

#ifndef PGSIZE
#define PGSIZE 4096
#endif

static const int chunk_classes[] = {16, 32, 64, 128, 256, 512, 1024, 2048, 4096};
#define N_CLASSES (sizeof(chunk_classes)/sizeof(chunk_classes[0]))

typedef struct page_node {
  void*  base;
  int    chunk_size;
  int    chunks_per_page;
  unsigned char* bitmap;
  struct page_node* next;
} page_node_t;

typedef struct bucket {
  int chunk_size;
  page_node_t* pages;
} bucket_t;

static bucket_t seg_buckets[N_CLASSES];

static inline int bit_test (unsigned char* bm, int i){ return (bm[i>>3] >> (i&7)) & 1; }
static inline void bit_set  (unsigned char* bm, int i){ bm[i>>3] |=  (1 << (i&7)); }
static inline void bit_clear(unsigned char* bm, int i){ bm[i>>3] &= ~(1 << (i&7)); }

static int round_chunk_size(int nbytes){
  for (int i=0;i<N_CLASSES;i++) if (chunk_classes[i] >= nbytes) return chunk_classes[i];
  return 4096;
}
static int class_index(int chunk_size){
  for (int i=0;i<N_CLASSES;i++) if (chunk_classes[i] == chunk_size) return i;
  return -1;
}

static inline void* page_base(void* p){
  uint64 a = (uint64)p;
  a &= ~(uint64)(PGSIZE-1);
  return (void*)a;
}

static int seg_inited = 0;
static void seg_init_once(void){
  if (seg_inited) return;
  for (int i=0;i<N_CLASSES;i++){
    seg_buckets[i].chunk_size = chunk_classes[i];
    seg_buckets[i].pages = 0;
  }
  seg_inited = 1;
}

static page_node_t* new_page_for_chunk(int chunk_size){
  void* p = sbrk(PGSIZE);
  if((long)p == -1) return 0;

  page_node_t* node = (page_node_t*) malloc(sizeof(page_node_t));
  if(!node) return 0;

  int chunks = PGSIZE / chunk_size;
  int bm_bytes = (chunks + 7) >> 3;
  unsigned char* bm = (unsigned char*) malloc(bm_bytes);
  if(!bm){ free(node); return 0; }

  for(int i=0;i<bm_bytes;i++) bm[i] = 0;

  node->base = p;
  node->chunk_size = chunk_size;
  node->chunks_per_page = chunks;
  node->bitmap = bm;
  node->next = 0;
  return node;
}

static void* alloc_from_page(page_node_t* pg){
  for(int i=0;i<pg->chunks_per_page;i++){
    if(!bit_test(pg->bitmap, i)){
      bit_set(pg->bitmap, i);
      return (void*)((char*)pg->base + (i * pg->chunk_size));
    }
  }
  return 0;
}

void*
block_alloc(int nbytes){
  seg_init_once();

  int csize = round_chunk_size(nbytes);
  int bidx = class_index(csize);
  if(bidx < 0) return 0;

  for(page_node_t* pg = seg_buckets[bidx].pages; pg; pg = pg->next){
    void* p = alloc_from_page(pg);
    if(p) return p;
  }

  page_node_t* npg = new_page_for_chunk(csize);
  if(!npg) return 0;

  npg->next = seg_buckets[bidx].pages;
  seg_buckets[bidx].pages = npg;

  return alloc_from_page(npg);
}

void
block_free(void* p){
  if(!p) return;

  void* base = page_base(p);

  for(int b = 0; b < N_CLASSES; b++){
    for(page_node_t* pg = seg_buckets[b].pages; pg; pg = pg->next){
      if(pg->base == base){
        int offset = (int)((uint64)p - (uint64)pg->base);
        if(offset < 0) return;
        if(offset % pg->chunk_size != 0) return;

        int idx = offset / pg->chunk_size;
        if(idx < 0 || idx >= pg->chunks_per_page) return;

        bit_clear(pg->bitmap, idx);
        return;
      }
    }
  }
}


static uint64 total_sbrk_bytes = 0;
static uint64 total_user_requested = 0;
// static uint64 total_user_freed = 0;
// Memory allocator by Kernighan and Ritchie,
// The C programming Language, 2nd ed.  Section 8.7.

typedef long Align;

union header {
  struct {
    union header *ptr;
    uint size;
  } s;
  Align x;
};

typedef union header Header;

static Header base;
static Header *freep;

void
free(void *ap)
{
  Header *bp, *p;

  bp = (Header*)ap - 1;
  for(p = freep; !(bp > p && bp < p->s.ptr); p = p->s.ptr)
    if(p >= p->s.ptr && (bp > p || bp < p->s.ptr))
      break;
  if(bp + bp->s.size == p->s.ptr){
    bp->s.size += p->s.ptr->s.size;
    bp->s.ptr = p->s.ptr->s.ptr;
  } else
    bp->s.ptr = p->s.ptr;
  if(p + p->s.size == bp){
    p->s.size += bp->s.size;
    p->s.ptr = bp->s.ptr;
  } else
    p->s.ptr = bp;
  freep = p;
}

static Header*
morecore(uint nu)
{
  char *p;
  Header *hp;

  if(nu < 4096)
    nu = 4096;
  p = sbrk(nu * sizeof(Header));
  if(p == SBRK_ERROR)
    return 0;
  total_sbrk_bytes += nu * sizeof(Header);
  hp = (Header*)p;
  hp->s.size = nu;
  free((void*)(hp + 1));
  return freep;
}

void*
malloc(uint nbytes)
{
  total_user_requested += nbytes;
  Header *p, *prevp;
  uint nunits;

  nunits = (nbytes + sizeof(Header) - 1)/sizeof(Header) + 1;
  if((prevp = freep) == 0){
    base.s.ptr = freep = prevp = &base;
    base.s.size = 0;
  }
  for(p = prevp->s.ptr; ; prevp = p, p = p->s.ptr){
    if(p->s.size >= nunits){
      if(p->s.size == nunits)
        prevp->s.ptr = p->s.ptr;
      else {
        p->s.size -= nunits;
        p += p->s.size;
        p->s.size = nunits;
      }
      freep = prevp;
      return (void*)(p + 1);
    }
    if(p == freep)
      if((p = morecore(nunits)) == 0)
        return 0;
  }
}

uint64
frag_bytes(void)
{
    uint64 fragmented = 0;
    if (total_sbrk_bytes > total_user_requested)
        fragmented = total_sbrk_bytes - total_user_requested;

    return fragmented;
}
